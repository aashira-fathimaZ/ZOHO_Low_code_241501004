 application "BookVerse Library System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form books
		{
			displayname = "Books"
			success message = "Books Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			book_id
			(
    			type = autonumber
				displayname = "Book Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			title
			(
    			type = text
				displayname = "Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			author
			(
    			type = text
				displayname = "Author"
	 			row = 1
	 			column = 1   
				width = medium
			)
			isbn
			(
    			type = text
				displayname = "Isbn"
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = picklist
				displayname = "Category"
				values = {"Reference","Science","Biography","Non-Fiction","Children","History","Fiction"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			publisher
			(
    			type = text
				displayname = "Publisher"
	 			row = 1
	 			column = 1   
				width = medium
			)
			publication_year
			(
				type = number
				displayname = "Publication Year"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_copies
			(
				type = number
				displayname = "Total Copies"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			available_copies
			(
				type = number
				displayname = "Available Copies"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			shelf_location
			(
    			type = text
				displayname = "Shelf Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form borrowing_transactions
		{
			displayname = "Borrowing Transactions"
			success message = "Transactions Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member
			(
				type = list	
				displayname = "Member"
				values  = members.ID
    			displayformat = [member_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			book
			(
				type = list	
				displayname = "Book"
				values  = books.ID
    			displayformat = [book_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			issue_date
			(
    			type = date
				displayname = "Issue Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			due_date
			(
    			type = date
				displayname = "Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			return_date
			(
    			type = date
				displayname = "Return Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			transaction_status
			(
				type = picklist
				displayname = "Transaction Status"
				values = {"Returned","Issued","Overdue"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			fine_amount
			(
				displayname = "Fine Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Transaction Initiated","Book Issued","Transaction Cancelled","Book Returned","Overdue","Fine Calculated","Fine Paid","Fine Waived","Transaction Closed","Book Damaged","Book Missing"}
			}
		}
		form members
		{
			displayname = "Members"
			success message = "Members Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member_id
			(
    			type = autonumber
				displayname = "Member Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			full_name
			(
    			type = name
				displayname = "Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department_or_class
			(
    			type = text
				displayname = "Department Or Class"
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_date
			(
    			type = date
				displayname = "Membership Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_status
			(
				type = radiobuttons
				displayname = "Membership Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list borrowing_transactions_Report
		{
			displayName = "All Transactions"
			show all rows from borrowing_transactions    
			(
				member as "Member"
				book as "Book"
				issue_date as "Issue Date"
				due_date as "Due Date"
				return_date as "Return Date"
				transaction_status as "Transaction Status"
				fine_amount as "Fine Amount"
				(
					display = total,average,min,max	
				)
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (transaction_status == "Overdue")
				fields = [transaction_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (transaction_status == "Returned")
				fields = [transaction_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban borrowing_transactions_by_transaction_status
		{
			displayName = "Transaction Statuses"
			show all rows from borrowing_transactions    
			(
				member as "Member"
				book as "Book"
				issue_date as "Issue Date"
				due_date as "Due Date"
				return_date as "Return Date"
				transaction_status as "Transaction Status"
				fine_amount as "Fine Amount"
				(
					display = total,average,min,max	
				)
			)
			options
			(
	 			display field = transaction_status
	 		)
		}
		list members_Report
		{
			displayName = "All Members"
			show all rows from members    
			(
				member_id as "Member Id"
				full_name  as "Full Name"
				email as "Email"
				phone_number as "Phone Number"
				department_or_class as "Department Or Class"
				membership_date as "Membership Date"
				membership_status as "Membership Status"
			)
		}
		list books_Report
		{
			displayName = "All Books"
			show all rows from books    
			(
				book_id as "Book Id"
				title as "Title"
				author as "Author"
				isbn as "Isbn"
				category as "Category"
				publisher as "Publisher"
				publication_year as "Publication Year"
				total_copies as "Total Copies"
				available_copies as "Available Copies"
				shelf_location as "Shelf Location"
			)
		}
		kanban books_by_category
		{
			displayName = "Categories"
			show all rows from books    
			(
				book_id as "Book Id"
				title as "Title"
				author as "Author"
				isbn as "Isbn"
				category as "Category"
				publisher as "Publisher"
				publication_year as "Publication Year"
				total_copies as "Total Copies"
				available_copies as "Available Copies"
				shelf_location as "Shelf Location"
			)
			options
			(
	 			display field = category
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '50%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'transparent'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3F3F3F'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.borrowing_transactions.fine_amount.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#909090'\n\tsize = '14px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n\n\n\n\n\n\n\t  value = 'Total Fine Amounts'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '20px'\n\tbgColor = 'transparent'\n\n\t\twidth = '50%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '10px'\n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = 'theme'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'business-money-bag'\n\tsize = '22px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='26%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\t\n\ttitle = 'Distribution by Membership Status'\n\t\n\t\ttitleSize = '16px'\n\t\t