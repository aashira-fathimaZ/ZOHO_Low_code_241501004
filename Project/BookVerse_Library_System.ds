		workflow
		{
		form
		{
			auto_update_available_copies as "Auto-Update Available Copies"
			{
				type =  form
				form = borrowing_transactions

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the borrowing transaction record that was just created
										transactionRecord = borrowing_transactions[ID == input.ID];
										// Check if the transaction status is 'Issued' and book field is populated
										if(transactionRecord.transaction_status == "Issued" && !transactionRecord.book.isNull())
										{
											// Get the book record from the multi-select lookup
											for each  bookRecord in transactionRecord.book
											{
												// Fetch the book record to update available copies
												bookDetails = books[ID == bookRecord.ID];
												// Check if book details exist and available copies is greater than 0
												if(!bookDetails.isNull() && bookDetails.available_copies > 0)
												{
													// Decrease the available copies by 1
													bookDetails.available_copies=bookDetails.available_copies - 1;
												}
											}
										}
						)
					}
				}

			}
			calculate_overdue_fine as "Calculate Overdue Fine"
			{
				type =  form
				form = borrowing_transactions

				record event = on edit

				on user input of return_date
				{
					actions 
					{
						custom deluge script
						(
											// Get the return date from user input
										returnDateValue = input.return_date;
										// Get the due date from the current record
										dueDateValue = input.due_date;
										// Check if both dates are valid
										if(!returnDateValue.isNull() && !dueDateValue.isNull())
										{
											// Calculate days between return date and due date
											daysOverdue = returnDateValue.daysBetween(dueDateValue);
											// If return date is after due date, calculate fine
											if(daysOverdue < 0)
											{
												// Calculate fine amount (assuming 10 currency units per day overdue)
												fineAmount = daysOverdue * -10;
												// Update the fine_amount field
												input.fine_amount = fineAmount;
											}
											else
											{
												// No fine if returned on or before due date
												input.fine_amount = 0;
											}
										}
										else
										{
											// If dates are not provided, set fine to 0
											input.fine_amount = 0;
										}
						)
					}
				}

			}
		}

		schedule
		{
			monthly_membership_renewal as "Monthly Membership Renewal"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch members with expired or expiring membership
										expiringMembers = members[membership_status == "Active" && membership_date < zoho.currentdate];
										// Iterate through each member and send notification
										for each  member in expiringMembers
										{
											// Validate member email is not null or empty
											if(member.email.isNull() || member.email.isEmpty())
											{
												continue;
											}
											// Send renewal notification email
											sendmail
											[
												from :zoho.loginuserid
												to :member.email
												subject :"Membership Renewal Reminder"
												message :"Dear " + member.full_name.first_name + ",\n\nYour membership is about to expire. Please renew your membership to continue enjoying our library services.\n\nBest regards,\nBookVerse Library Team"
											]
										}
					)
					}
				}
			}
		}


