				displayname = "Cost per Unit"
				type = USD
	 			row = 2
	 			column = 1   
				width = medium
			)
			Total_Cost
			(
				displayname = "Total Cost"
				type = USD
	 			row = 2
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = radiobuttons
				values = {"High","Low","Medium"}
				others option = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Tracking_ID
			(
    			type = text
				displayname = "Tracking ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = text
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
