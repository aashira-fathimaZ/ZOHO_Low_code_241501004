	reports
	{
		kanban Order_Status_Kanban
		{
			displayName = "Order Status Kanban"
			show all rows from Add_Order    
			(
				Order_ID as "Order ID"
				Product_Name as "Product Name"
				Supplier
				Quantity
				Order_Date as "Order Date"
				Delivery_Date as "Delivery Date"
				Status
				Destination
				Cost_per_Unit as "Cost per Unit"
				Total_Cost as "Total Cost"
				Priority
				Tracking_ID as "Tracking ID"
				Notes
			)
			options
			(
	 			display field = Status
				sort order  = descending
	 		)
		}
		list All_Orders
		{
			displayName = "All Orders"
			show all rows from Add_Order    
			(
				Order_ID as "Order ID"
				Product_Name as "Product Name"
				(
					width = 157px
				)
				Supplier
				(
					width = 138px
				)
				Quantity
				(
					width = 103px
				)
				Order_Date as "Order Date"
				(
					width = 129px
				)
				Delivery_Date as "Delivery Date"
				(
					width = 149px
				)
				Status
				(
					width = 133px
				)
				Destination
				(
					width = 141px
				)
				Cost_per_Unit as "Cost per Unit"
				(
					width = 136px
				)
				Total_Cost as "Total Cost"
				(
					width = 112px
				)
				Priority
				(
					width = 100px
				)
				Tracking_ID as "Tracking ID"
				(
					width = 117px
				)
				Notes
				(
					width = 228px
				)
			)
			conditional formatting
			(
				"Completed Orders"
				{
				condition = (Status == "Completed")
				fields = [Status]
				format = "color:##ffffff;background-color:#1bbc9b;"
				}
				"Cancelled Orders"
				{
				condition = (Status == "Cancelled")
				fields = [Status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"Processing Orders"
				{
				condition = (Status == "Processing")
				fields = [Status]
				format = "color:#333;background-color:#f1c40f;"
				}
				"In-Transit Orders"
				{
				condition = (Status == "In Transit")
				fields = [Status]
				format = "color:#333;background-color:#c7c116;"
				}
				"Delayed Orders"
				{
				condition = (Status == "Delayed")
				fields = [Status]
				format = "color:#ffffff;background-color:#bd588b;"
				}
				"Delayed Orders"
				{
				condition = (Status == "Delayed")
				fields = [Status]
				format = "color:#ffffff;background-color:#bd588b;"
				}
			)
		}
	}
