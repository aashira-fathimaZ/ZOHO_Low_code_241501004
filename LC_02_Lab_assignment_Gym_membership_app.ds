yle=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\"> secured.</span></span></span></span><br /></div>"
	 			row = 1
