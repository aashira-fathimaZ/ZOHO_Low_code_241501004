			(
    			type = text
	 			row = 2
	 			column = 1   
				width = medium
			)
			Quantity
			(
				type = number
	 			row = 2
	 			column = 1   
				width = medium
			)
			Order_Date
			(
    			type = date
				displayname = "Order Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Delivery_Date
			(
    			type = date
				displayname = "Delivery Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Cancelled","Completed","Delayed","In Transit","Processing"}
